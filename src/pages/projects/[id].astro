---
import projects_config from "@/projects-config.json";
import { parse } from "date-fns";
import IdHeader from "@/components/static/IdHeader.astro";
import IdLayout from "@/layouts/IdLayout.astro";
import ProjectGallery from "@/components/static/ProjectGallery.astro";
import ProjectDetails from "@/components/static/ProjectDetails.astro";
import type { ImageMetadata } from "astro";
import type { projectConfig } from "@/lib/types";
import { RiArrowRightUpLine, RiExternalLinkLine } from "@remixicon/react";

export function getStaticPaths() {
    return projects_config.map((item) => ({
        params: { id: item.id },
        props: { item },
    }));
}

const { item } = Astro.props;

const allItems = projects_config.sort((a, b) => {
    const dateA = parse(a.data.date, "dd-MM-yyyy", new Date());
    const dateB = parse(b.data.date, "dd-MM-yyyy", new Date());
    return dateB.getTime() - dateA.getTime();
});

const currentIndex = allItems.findIndex((i) => i.id === item.id);
const prev = currentIndex > 0 ? allItems[currentIndex - 1] : null;
const next = currentIndex < allItems.length - 1 ? allItems[currentIndex + 1] : null;

const pubDate = parse(item.data.date, "dd-MM-yyyy", new Date());

type ImageRecord = { default: ImageMetadata };
const imageModules = import.meta.glob<ImageRecord>("@/assets/projects/*/*.{png,jpg,jpeg,webp,gif,avif}", { eager: true });
const projectImages = Object.entries(imageModules)
    .filter(([path]) => path.includes(`/assets/projects/${item.id}/`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);

const links = item?.links ?? [];
---

<IdLayout type="projects" title={item.data.title} description={item.data.description} image={`/og/projects/${item.id}.png`} pubDate={pubDate} tags={item.data.tags} prev={prev} next={next}>
    <article transition:animate="fade">
        <IdHeader backUrl="/projects" items={item.data} />

        <div class="mt-10">
            {
                item.credits && item.credits.length > 0 && (
                    <div class="w-full flex flex-wrap items-center gap-2 border border-border border-b-0 px-6 py-3">
                        <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-muted-foreground mr-1">
                            参与成员
                        </span>
                        {item.credits.map((c) => (
                            <span class="inline-flex items-center gap-1 border border-border bg-muted px-2 py-1 font-mono text-xs text-foreground/75">
                                {c.grade && <span class="text-brand/80">{c.grade}</span>}
                                {c.grade && <span class="text-muted-foreground/50">·</span>}
                                <span>{c.name}</span>
                            </span>
                        ))}
                        {item.creditsNote && (
                            <span class="font-mono text-xs text-muted-foreground">{item.creditsNote}</span>
                        )}
                    </div>
                )
            }
            {
                links.length > 0 && (
                    <div class="w-full flex flex-wrap p-3 border border-border border-b-0">
                        <RiExternalLinkLine className="size-4 ml-3 my-auto text-secondary-foreground/90" />
                        {links.map((link) => (
                            <a href={link.url} target="_blank" rel="noopener noreferrer" class="ml-3 text-sm text-muted-foreground/80 hover:text-secondary-foreground/90 hover:underline underline-offset-3 hover:underline-offset-6 animation active:text-background active:bg-secondary-foreground px-1">
                                {link.label}
                            </a>
                        ))}
                    </div>
                )
            }
            {(projectImages.length > 0 || item.video) && (
                <ProjectGallery item={item as projectConfig} images={projectImages} />
            )}
            <ProjectDetails item={item as projectConfig} />
        </div>
    </article>
</IdLayout>
